# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ticketing_platform_noai
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:15432/ticketing_platform_noai

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0

# Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# OAuth client id from Google Cloud Console; ID tokens for any other client are rejected
GOOGLE_CLIENT_ID=
# Failed manager log-ins allowed per client IP and email before /admin/auth/login answers 429
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
