# Test environment: points every component at the isolated stack defined in
# docker-compose.test.yaml (distinct ports, distinct volumes, distinct db name).
#
# The e2e fixtures TRUNCATE ... CASCADE and flush Redis, so they must never
# reach the developer's own stack. tests/conftest.py refuses to run if the
# values below are not in effect.
#
# Bring the stack up with this same file, otherwise docker compose picks up
# the default .env and creates the container with the wrong database name:
#
#   docker compose --env-file .env.test -f docker-compose.test.yaml up -d
#   ENV_FILE=.env.test uv run alembic upgrade head

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ticketing_test_db
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:55432/ticketing_test_db

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379/0

# The scheduler is already disabled under pytest, but an explicit false keeps
# a stray non-pytest run against this env from starting background jobs.
ENABLE_CRON_JOBS=false
